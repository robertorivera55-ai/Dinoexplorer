package logic;

public abstract class Dinosaurio {
    protected String nombre;
    protected String periodo;
    protected double peso;

    public Dinosaurio(String nombre, String periodo, double peso) {
        this.nombre = nombre;
        this.periodo = periodo;
        this.peso = peso;
    }

    public abstract String getFichaTecnica(); // Método abstracto (Polimorfismo)

    public String getNombre() { return nombre; }
}
